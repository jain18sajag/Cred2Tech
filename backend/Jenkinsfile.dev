// ─────────────────────────────────────────────────────────────────────────────
// DEVELOPMENT CI/CD pipeline for cred2tech-backend (Express + Prisma / PostgreSQL).
//
// Sibling of Jenkinsfile (production) — same monorepo, same deploy shape, but
// completely separate everything else: PM2 app, on-disk path, port, .env
// credential, and database. Nothing here can touch production.
//
//   • Trigger: any branch push EXCEPT main (that's what Jenkinsfile handles).
//     Point this at whichever branch you're actively testing (e.g. ESR-v2) by
//     just pushing to it — no Jenkins config change needed per branch.
//   • Database: a dedicated dev database (see DEV DATABASE below) — never the
//     production DATABASE_URL. Migrations run automatically on every deploy
//     (dev is meant to always match the branch's schema; prod requires an
//     explicit RUN_MIGRATIONS flag on purpose — dev doesn't need that caution).
//   • No production-style approval gate or Google Chat ceremony — dev deploys
//     are meant to be fast and unattended so a developer can just push and
//     look. A lightweight pre-deploy backup still runs (cheap, non-blocking on
//     failure) purely so a bad migration on dev is still recoverable.
//   • Domain/access: this only starts the process on APP_PORT on localhost —
//     making it reachable at a developer-only domain (e.g.
//     dev.api.cred2tech.com) is an nginx vhost + DNS + access-restriction
//     (IP allowlist / basic auth / VPN) step outside this file. See the setup
//     notes at the bottom of this comment block.
//
// ── One-time setup this pipeline assumes is already done on the box ──────────
//   1. Directories:  /opt/cred2tech/cred2tech-backend-dev/{releases,shared}
//   2. Dev env file (or Jenkins "Secret file" credential, preferred):
//        DATABASE_URL=<same host/user/password as prod, database name dsacrm_dev>
//        PORT=5002                      (anything free — not 5000/5001)
//        ALLOWED_ORIGINS=<dev frontend origin(s) — e.g. a Vercel preview URL>
//        FRONTEND_URL=https://dev.app.cred2tech.com   (or your chosen dev URL)
//        + all the other keys from .env.example (JWT_SECRET etc.) — these
//        should be DIFFERENT values from production's, not copies, so a dev
//        JWT/session can never be replayed against prod and vice versa.
//   3. Jenkins credentials: 'cred2tech-backend-dev-env' (Secret file, the env
//      above) and reuse of 'github-cred2tech' for checkout.
//   4. Jenkins job: New Pipeline job, Script Path = backend/Jenkinsfile.dev,
//      webhook token credential 'cred2tech-backend-dev-webhook-token' (can be
//      a distinct GitHub webhook, or the same webhook with both jobs
//      registered — Jenkins dispatches to whichever job's trigger regex
//      matches the pushed ref).
//   5. nginx: a server block for dev.api.cred2tech.com proxying to
//      127.0.0.1:5002 (or whatever PORT you chose), restricted to developer
//      IPs / behind basic auth / VPN-only — this is what makes it
//      "developer-only", not anything in this pipeline.
//   6. DNS: dev.api.cred2tech.com -> the same VPS, or wherever you point it.
//
// Set Jenkins job "Script Path" = backend/Jenkinsfile.dev.
// ─────────────────────────────────────────────────────────────────────────────
pipeline {
    agent any

    tools {
        nodejs 'node-lts'
    }

    parameters {
        booleanParam(
            name: 'FORCE_DEPLOY',
            defaultValue: false,
            description: 'Deploy even if this push did not change backend/ (e.g. manual redeploy).'
        )
    }

    environment {
        SERVICE       = 'cred2tech-backend-dev'
        PM2_APP       = 'cred2tech-backend-dev'
        DEPLOY_BASE   = '/opt/cred2tech/cred2tech-backend-dev'
        ENV_FILE      = '/etc/cred2tech/cred2tech-backend-dev.env'
        ENV_CREDENTIAL_ID = 'cred2tech-backend-dev-env'
        BACKEND_DIR   = 'backend'
        NOTIFY_EMAIL  = 'adarsh.suradkar@cred2tech.com, cred2tech@gmail.com'
        GIT_REPO      = 'https://github.com/jain18sajag/Cred2Tech.git'
        // Reuses the SAME backup script as production — it reads ENV_FILE
        // from the environment, so pointing it at the dev env file backs up
        // dsacrm_dev, never production. Non-blocking here (see stage below),
        // unlike prod where a failed backup aborts the deploy.
        BACKUP_SCRIPT = '/opt/cred2tech/scripts/cred2tech-backend-db-backup.sh'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
    }

    // ── Generic Webhook Trigger ────────────────────────────────────────────────
    // Fires on ANY branch push EXCEPT main (negative lookahead) — main is
    // Jenkinsfile's job, never this one. Whichever branch you push becomes
    // what's live on dev until you push another.
    triggers {
        GenericTrigger(
            genericVariables: [
                [key: 'ref',     value: '$.ref'],
                [key: 'deleted', value: '$.deleted', defaultValue: 'false'],
                [key: 'pusher',  value: '$.pusher.name', defaultValue: 'unknown']
            ],
            causeString: 'Pushed to $ref by $pusher',
            tokenCredentialId: 'cred2tech-backend-dev-webhook-token',
            printContributedVariables: false,
            printPostContent: false,
            regexpFilterText: '$ref:$deleted',
            regexpFilterExpression: '^refs/heads/(?!main$).+:false$'
        )
    }

    stages {

        // ── 1. Checkout (whichever branch triggered this build) ─────────────────
        stage('Checkout') {
            steps {
                cleanWs()
                script {
                    // GenericTrigger gives us the raw ref (refs/heads/<branch>);
                    // fall back to env.ref if this was a manual "Build Now".
                    env.SOURCE_BRANCH = env.ref ? env.ref.replaceFirst('^refs/heads/', '') : 'ESR-v2'
                    echo "Deploying branch: ${env.SOURCE_BRANCH}"
                }
                git branch: "${env.SOURCE_BRANCH}",
                    credentialsId: 'github-cred2tech',
                    url: "${GIT_REPO}"
            }
        }

        // ── 2. Refuse to ever run this job against main ──────────────────────────
        // Belt-and-suspenders on top of the trigger regex — if someone manually
        // launches this job with main selected, stop instead of dev-deploying
        // production code with dev secrets/DB.
        stage('Validate Branch') {
            steps {
                script {
                    if (env.SOURCE_BRANCH == 'main') {
                        error("Jenkinsfile.dev must never deploy main — that's production's job (Jenkinsfile). Aborting.")
                    }
                    echo "Branch validated: ${env.SOURCE_BRANCH} (not main, OK for dev)"
                }
            }
        }

        // ── 3. Detect Backend Changes (mono-repo gate) ───────────────────────────
        stage('Detect Backend Changes') {
            steps {
                script {
                    if (params.FORCE_DEPLOY) {
                        env.BACKEND_CHANGED = 'true'
                        echo "FORCE_DEPLOY set — deploying regardless of changed paths."
                    } else if (!env.GIT_PREVIOUS_SUCCESSFUL_COMMIT?.trim() || !env.GIT_COMMIT?.trim()) {
                        env.BACKEND_CHANGED = 'true'
                        echo "No previous successful commit recorded — treating as a backend change (safe default)."
                    } else {
                        def changed = sh(
                            script: """
                                if git rev-parse --verify --quiet ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT}^{commit} >/dev/null \
                                   && git rev-parse --verify --quiet ${env.GIT_COMMIT}^{commit} >/dev/null; then
                                    git diff --name-only ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT} ${env.GIT_COMMIT} | grep -E '^${BACKEND_DIR}/' || true
                                else
                                    echo '__DIFF_UNAVAILABLE__'
                                fi
                            """,
                            returnStdout: true
                        ).trim()
                        env.BACKEND_CHANGED = changed ? 'true' : 'false'
                        if (changed == '__DIFF_UNAVAILABLE__') {
                            echo "Could not resolve commit range — deploying to be safe."
                        } else {
                            echo changed ? "Backend changes detected:\n${changed}" : "No backend/ changes in this push — skipping deploy."
                        }
                    }
                    if (env.BACKEND_CHANGED != 'true') {
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.description = 'Skipped — no backend changes'
                    }
                }
            }
        }

        // ── 4. Deploy Backend (dev) ──────────────────────────────────────────────
        stage('Deploy Backend (dev)') {
            when { expression { env.BACKEND_CHANGED == 'true' } }
            stages {

                stage('Stage .env (Jenkins Credentials)') {
                    steps {
                        script {
                            env.STAGED_ENV = "${env.WORKSPACE}/.env.release"
                            def loaded = false
                            try {
                                withCredentials([file(credentialsId: env.ENV_CREDENTIAL_ID, variable: 'ENV_SECRET_FILE')]) {
                                    sh '''
                                        set -eu
                                        test -s "$ENV_SECRET_FILE" || { echo "Credential .env is empty."; exit 1; }
                                        grep -qE '^[A-Za-z_][A-Za-z0-9_]*=' "$ENV_SECRET_FILE" || { echo "Credential .env has no KEY=VALUE lines."; exit 1; }
                                        grep -qE '^DATABASE_URL=' "$ENV_SECRET_FILE" || { echo "Credential .env is missing DATABASE_URL (looks wrong)."; exit 1; }
                                        # Hard safety check: refuse to deploy if the staged DATABASE_URL
                                        # points at the production database name. This is the single
                                        # most important guard in this whole file.
                                        if grep -E '^DATABASE_URL=' "$ENV_SECRET_FILE" | grep -qE '/dsacrm(\\?|$)'; then
                                            echo "FATAL: staged DATABASE_URL points at the PRODUCTION database (dsacrm). Refusing to deploy dev against it."
                                            exit 1
                                        fi
                                        install -m 600 "$ENV_SECRET_FILE" "$STAGED_ENV"
                                        echo "Materialized Jenkins credential → $STAGED_ENV"
                                    '''
                                }
                                loaded = true
                            } catch (err) {
                                echo "Credential '${env.ENV_CREDENTIAL_ID}' not usable (${err.message}). Falling back to on-box ${ENV_FILE}."
                                sh '''
                                    set -eu
                                    test -f "$ENV_FILE" || { echo "No credential and no on-box env at $ENV_FILE — cannot deploy."; exit 1; }
                                    if grep -E '^DATABASE_URL=' "$ENV_FILE" | grep -qE '/dsacrm(\\?|$)'; then
                                        echo "FATAL: on-box dev env DATABASE_URL points at the PRODUCTION database (dsacrm). Refusing to deploy."
                                        exit 1
                                    fi
                                    install -m 600 "$ENV_FILE" "$STAGED_ENV"
                                    echo "Staged on-box env → $STAGED_ENV"
                                '''
                            }
                            env.ENV_SOURCE = loaded ? "Jenkins credential '${env.ENV_CREDENTIAL_ID}'" : "on-box ${ENV_FILE} (credential fallback)"
                            echo ".env source for this release: ${env.ENV_SOURCE}"
                        }
                    }
                }

                // ── 4a. Database Backup (best-effort, non-blocking) ──────────────
                // Same script as prod, pointed at the dev env — backs up
                // dsacrm_dev only. Unlike prod, a failure here WARNS but does
                // not abort the deploy (dev data loss is recoverable by just
                // re-running the app's normal test-data setup).
                stage('Database Backup (dev, best-effort)') {
                    steps {
                        script {
                            try {
                                def out = sh(returnStdout: true, script: """
                                    set -euo pipefail
                                    export ENV_FILE="${env.STAGED_ENV}"
                                    if [ -x "${BACKUP_SCRIPT}" ]; then
                                        SCRIPT="${BACKUP_SCRIPT}"
                                    else
                                        SCRIPT="${BACKEND_DIR}/scripts/db-backup.sh"
                                        chmod +x "\$SCRIPT"
                                    fi
                                    "\$SCRIPT" predeploy-dev
                                """).trim()
                                echo out
                            } catch (err) {
                                echo "Dev DB backup failed or skipped (non-blocking): ${err.message}"
                            }
                        }
                    }
                }

                stage('Install & Validate') {
                    steps {
                        sh """
                            cd ${BACKEND_DIR}
                            npm ci
                            npx prisma generate
                            JWT_SECRET=ci-validate-placeholder node -e "require('./src/app.js'); console.log('app.js loads OK'); process.exit(0)"
                            echo "Dependencies installed, Prisma client generated, app loads."
                        """
                    }
                }

                stage('Generate Artifact') {
                    steps {
                        script {
                            env.RELEASE_TS  = sh(script: 'date +%Y%m%d_%H%M%S', returnStdout: true).trim()
                            env.RELEASE_DIR = "${DEPLOY_BASE}/releases/${env.RELEASE_TS}"
                            env.DEPLOYED    = 'false'
                            env.APP_PORT = sh(
                                returnStdout: true,
                                script: "grep -E '^PORT=' \"${env.STAGED_ENV}\" 2>/dev/null | tail -1 | cut -d= -f2- | tr -dc '0-9' || true"
                            ).trim()
                            if (!env.APP_PORT) { env.APP_PORT = '5002' }
                            echo "Release ID: ${env.RELEASE_TS}"
                            echo "Target:     ${env.RELEASE_DIR}"
                            echo "App port:   ${env.APP_PORT} (from ${env.ENV_SOURCE})"
                        }
                    }
                }

                stage('Create Release') {
                    steps {
                        script {
                            env.PREV_RELEASE = sh(
                                script: "if [ -L ${DEPLOY_BASE}/current ] && [ -e ${DEPLOY_BASE}/current ]; then readlink -f ${DEPLOY_BASE}/current 2>/dev/null || true; else echo ''; fi",
                                returnStdout: true
                            ).trim()

                            sh """
                                mkdir -p ${env.RELEASE_DIR}
                                cp -r ${BACKEND_DIR}/src               ${env.RELEASE_DIR}/
                                cp -r ${BACKEND_DIR}/config            ${env.RELEASE_DIR}/
                                cp -r ${BACKEND_DIR}/prisma            ${env.RELEASE_DIR}/
                                cp -r ${BACKEND_DIR}/scripts           ${env.RELEASE_DIR}/ 2>/dev/null || true
                                cp -r ${BACKEND_DIR}/docs              ${env.RELEASE_DIR}/ 2>/dev/null || true
                                cp    ${BACKEND_DIR}/server.js         ${env.RELEASE_DIR}/
                                cp    ${BACKEND_DIR}/package.json      ${env.RELEASE_DIR}/
                                cp    ${BACKEND_DIR}/package-lock.json ${env.RELEASE_DIR}/
                                cp    "${env.STAGED_ENV}"              "${env.RELEASE_DIR}/.env"
                                echo "Release folder ready: ${env.RELEASE_DIR}"
                            """

                            sh """
                                mkdir -p ${DEPLOY_BASE}/shared/uploads
                                mkdir -p ${DEPLOY_BASE}/shared/logs/esr
                                chmod 775 ${DEPLOY_BASE}/shared/logs ${DEPLOY_BASE}/shared/logs/esr
                                ln -sfn ${DEPLOY_BASE}/shared/uploads ${env.RELEASE_DIR}/uploads
                                ln -sfn ${DEPLOY_BASE}/shared/logs    ${env.RELEASE_DIR}/logs
                            """

                            sh """
                                COMMIT=\$(git rev-parse --short HEAD)
                                printf '{"release":"%s","commit":"%s","build":"%s","branch":"%s","env":"development"}\\n' \
                                    "${env.RELEASE_TS}" "\$COMMIT" "${BUILD_NUMBER}" "${env.SOURCE_BRANCH}" \
                                    > ${env.RELEASE_DIR}/version.json
                                echo "version.json: \$(cat ${env.RELEASE_DIR}/version.json)"
                            """

                            sh """
                                cat > ${env.RELEASE_DIR}/ecosystem.config.js << 'ECOEOF'
module.exports = {
  apps: [
    {
      name: '${PM2_APP}',
      script: '${DEPLOY_BASE}/current/server.js',
      cwd: '${DEPLOY_BASE}/current',
      instances: 1,
      exec_mode: 'fork',
      env_production: { PORT: ${APP_PORT} },
      watch: false,
      max_memory_restart: '512M',
      error_file: '/var/log/pm2/${PM2_APP}-error.log',
      out_file: '/var/log/pm2/${PM2_APP}-out.log',
      log_date_format: 'YYYY-MM-DD HH:mm:ss Z',
      merge_logs: true,
      restart_delay: 3000,
      max_restarts: 5,
      min_uptime: '10s',
      kill_timeout: 5000,
    },
  ],
};
ECOEOF
                                echo "ecosystem.config.js written → script points at ${DEPLOY_BASE}/current"
                            """
                        }
                    }
                }

                stage('Install Prod Deps') {
                    steps {
                        sh """
                            cd ${env.RELEASE_DIR}
                            npm ci
                            npx prisma generate
                        """
                    }
                }

                // ── DB Migrate — ALWAYS on for dev, unlike prod's opt-in flag.
                // Dev exists to prove out schema changes on real data before
                // they ever reach the production RUN_MIGRATIONS decision, so
                // it should always be caught up with whatever branch is live.
                stage('DB Migrate (dev, always on)') {
                    steps {
                        sh """
                            cd ${env.RELEASE_DIR}
                            echo "Applying Prisma migrations to DEV database (prisma migrate deploy)…"
                            npx prisma migrate deploy
                            echo "Migrations applied to dev."
                        """
                    }
                }

                stage('Switch Symlink') {
                    steps {
                        sh """
                            ln -sfn ${env.RELEASE_DIR} ${DEPLOY_BASE}/current
                            REL_SHA=\$(sha256sum ${env.RELEASE_DIR}/.env | cut -d' ' -f1)
                            LIVE_SHA=\$(sha256sum ${DEPLOY_BASE}/current/.env | cut -d' ' -f1)
                            [ "\$REL_SHA" = "\$LIVE_SHA" ] || { echo "FAIL: live current/.env does not match the release .env."; exit 1; }
                            echo "Confirmed: current/.env serves release ${env.RELEASE_TS}'s injected secrets."
                        """
                        script { env.DEPLOYED = 'true' }
                    }
                }

                stage('PM2 Reload') {
                    steps {
                        sh """
                            PM2="\$(which pm2)"
                            ECO="${DEPLOY_BASE}/current/ecosystem.config.js"
                            STABLE_PATH="${DEPLOY_BASE}/current/server.js"
                            RUNNING_PATH=\$(sudo \$PM2 jlist 2>/dev/null | python3 -c "
import sys, json
try:
    data = sys.stdin.read()
    apps = json.loads(data[data.index('['):])
    match = [a for a in apps if a['name'] == '${PM2_APP}']
    print(match[0]['pm2_env'].get('pm_exec_path', '') if match else 'absent')
except Exception:
    print('absent')
" || echo 'absent')
                            if [ "\$RUNNING_PATH" = "\$STABLE_PATH" ]; then
                                sudo \$PM2 reload \$ECO --env production --update-env
                            else
                                sudo \$PM2 delete ${PM2_APP} 2>/dev/null || true
                                sudo \$PM2 start \$ECO --env production
                            fi
                            sudo \$PM2 save
                            echo "PM2 process live (dev)."
                        """
                    }
                }

                stage('Health Check') {
                    steps {
                        script {
                            def healthy = false
                            for (int i = 1; i <= 12; i++) {
                                def code = '000'
                                try {
                                    code = sh(script: "curl -s -o /dev/null -w '%{http_code}' http://localhost:${APP_PORT}/health", returnStdout: true).trim()
                                } catch (Exception ignored) {}
                                if (code == '200') { healthy = true; echo "Health check passed (attempt ${i}/12): HTTP ${code}"; break }
                                echo "Attempt ${i}/12: HTTP ${code} — waiting 5s..."
                                sleep(5)
                            }
                            if (!healthy) { error("Health check failed after 12 attempts — triggering rollback.") }
                        }
                    }
                }

                stage('Version Verification') {
                    steps {
                        script {
                            def verified = false
                            for (int i = 1; i <= 6; i++) {
                                try {
                                    def response = sh(script: "curl -sf http://localhost:${APP_PORT}/health", returnStdout: true).trim()
                                    def data = new groovy.json.JsonSlurper().parseText(response)
                                    if (data.release == env.RELEASE_TS) { verified = true; echo "Version verified ✓ release=${data.release} commit=${data.commit} branch=${env.SOURCE_BRANCH}"; break }
                                    echo "Attempt ${i}/6: running release=${data.release}, expected=${env.RELEASE_TS} — waiting 5s..."
                                } catch (Exception e) {
                                    echo "Attempt ${i}/6: /health unreachable — ${e.message}"
                                }
                                sleep(5)
                            }
                            if (!verified) { error("Version verification FAILED — dev is not serving release ${env.RELEASE_TS}.") }
                        }
                    }
                }

                stage('Cleanup Old Releases') {
                    steps {
                        sh """
                            cd ${DEPLOY_BASE}/releases
                            ls -dt */ | tail -n +4 | while IFS= read -r dir; do
                                rm -rf "\$dir" 2>/dev/null || echo "Warning: could not fully remove \$dir"
                            done
                            echo "Cleanup done. Retained last 3 dev releases."
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            emailext(
                to: "${env.NOTIFY_EMAIL}",
                subject: "[${SERVICE}] Build #${BUILD_NUMBER} deployed (branch: ${env.SOURCE_BRANCH ?: '?'})",
                body: """
                    <h2 style="color:#059669;">Dev deployment successful</h2>
                    <table>
                      <tr><td><b>Branch</b></td><td>${env.SOURCE_BRANCH ?: '—'}</td></tr>
                      <tr><td><b>Release</b></td><td>${env.RELEASE_TS ?: '—'}</td></tr>
                      <tr><td><b>Duration</b></td><td>${currentBuild.durationString}</td></tr>
                    </table>
                    <p><a href="${BUILD_URL}">View Build</a></p>
                """,
                mimeType: 'text/html'
            )
        }
        failure {
            script {
                if (env.DEPLOYED == 'true' && env.PREV_RELEASE?.trim()) {
                    echo "Dev deployment failed — rolling CODE back to: ${env.PREV_RELEASE}"
                    sh """
                        PM2="\$(which pm2)"
                        ln -sfn ${env.PREV_RELEASE} ${DEPLOY_BASE}/current
                        cd ${DEPLOY_BASE}/current
                        sudo \$PM2 reload ecosystem.config.js --env production --update-env 2>/dev/null || sudo \$PM2 start ecosystem.config.js --env production
                        sudo \$PM2 save
                        echo "Dev code rolled back → ${env.PREV_RELEASE}"
                    """
                } else {
                    echo "Failure before symlink switch — no code rollback needed."
                }
            }
            emailext(
                to: "${env.NOTIFY_EMAIL}",
                subject: "[${SERVICE}] Build #${BUILD_NUMBER} FAILED (branch: ${env.SOURCE_BRANCH ?: '?'})",
                body: "<h2 style=\"color:#dc2626;\">Dev deployment failed</h2><p>Branch: ${env.SOURCE_BRANCH ?: '—'}</p><p><a href=\"${BUILD_URL}console\">Console</a></p>",
                mimeType: 'text/html'
            )
        }
        always {
            cleanWs()
        }
    }
}
